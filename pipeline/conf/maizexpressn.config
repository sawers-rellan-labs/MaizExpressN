// MaizExpressN settings for nf-core/rnaseq.
// Use together with the nf-core institutional profile for Hazel (Slurm + Singularity):
//   nextflow run nf-core/rnaseq -r <version> -profile hazel -c conf/maizexpressn.config ...
// run_study.sh does this; see pipeline/README.md.

params {
    // B73 RefGen_v5 (Zm-B73-REFERENCE-NAM-5.0), gene models Zm00001eb.1, fetched by get_reference.sh
    fasta = '/share/maize/rrellan/MaizExpressN/reference/Zm-B73-REFERENCE-NAM-5.0.fa.gz'
    gff   = '/share/maize/rrellan/MaizExpressN/reference/Zm-B73-REFERENCE-NAM-5.0_Zm00001eb.1.gff3.gz'

    // Salmon pseudo-alignment only. nf-core/rnaseq builds a decoy-aware index
    // (transcripts + genome as decoys); salmon runs with --libType A by default
    // and selective alignment (--validateMappings) is salmon's default mode.
    pseudo_aligner        = 'salmon'
    skip_alignment        = true
    trimmer               = 'fastp'
    skip_bbsplit          = true
    skip_biotype_qc       = true
    // gtf_extra_attributes stays at the nf-core default ('gene_name'): MaizeGDB models have no
    // gene_name, so the pipeline fills that column with gene_id. An empty value breaks tximport.
    save_reference        = true    // keep the transcript FASTA, GTF and salmon index for reuse
}

// Slurm account and QoS for every task job (Hazel: account maize_cpu; QoS normal = 4 days,
// up to 256 CPUs per job on the compute partition, which the hazel profile uses).
process {
    clusterOptions = '--account=maize_cpu --qos=normal'
    // the hazel profile runs 'module load singularity'; batch shells need the module system first
    beforeScript   = 'source /etc/profile.d/modules.sh && module load singularity'

    // Transcript FASTA extraction is light, but nf-core labels it process_high (12 CPUs, 72 GB),
    // which waits many hours on the busy compute partition. Right-size it so it backfills.
    withName: '.*:MAKE_TRANSCRIPTS_FASTA' {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
    }
    // Decoy-aware salmon index for the 2.1 Gb maize genome: run on the maize partner
    // allocation (compute_partners, QoS p_maize: up to 32 CPUs for the group).
    // Salmon quant: Mu2017 used ~10 GB of the 36 GB default and 20-55 min on 6 CPUs per sample.
    // Smaller memory requests start sooner on the busy partition; more threads finish sooner.
    withName: '.*:SALMON_QUANT' {
        cpus   = 12
        memory = 16.GB
        time   = 8.h
    }
    withName: '.*:SALMON_INDEX' {
        cpus           = 16
        memory         = 64.GB
        time           = 12.h
        queue          = 'compute_partners'
        clusterOptions = '--account=maize_cpu --qos=p_maize'
    }
}

// Container images: per-user scratch cache (the profile also reads the BRC shared library first)
singularity {
    cacheDir = '/share/maize/rrellan/MaizExpressN/singularity'
}
