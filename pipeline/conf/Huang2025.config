// Huang2025 only (run_study.sh adds conf/<study>.config when one exists).
// Lexogen QuantSeq 3' mRNA-seq FWD with the UMI Second Strand Synthesis Module, NextSeq
// 76-nt single-end. Each read starts with a 6-nt UMI and a TATA spacer (89% of reads,
// checked 17 Oct 2026). UMI deduplication needs aligned reads, so this study runs
// STAR -> umi_tools dedup -> salmon (alignment mode) instead of salmon pseudo-alignment.
// No length correction: a 3' tag counts once per transcript whatever the transcript length.
params {
    skip_alignment          = false
    aligner                 = 'star_salmon'
    skip_pseudo_alignment   = true
    with_umi                = true
    umitools_extract_method = 'regex'
    umitools_bc_pattern     = '^(?P<umi_1>.{6})(?P<discard_1>.{4}).*'
    extra_fastp_args        = '--trim_poly_x --length_required 20'   // poly(A) tails at the 3' end
    extra_salmon_quant_args = '--noLengthCorrection'
    save_reference          = false     // the STAR index (~25 GB) stays in the work dir on scratch
    skip_markduplicates     = true      // UMIs do the deduplication
    skip_qualimap           = true
    skip_rseqc              = true
    skip_dupradar           = true
    skip_stringtie          = true
    skip_bigwig             = true
}

process {
    withName: '.*:STAR_GENOMEGENERATE' {
        cpus = 16; memory = 64.GB; time = 12.h
        queue = 'compute_partners'; clusterOptions = '--account=maize_cpu --qos=p_maize'
    }
    withName: '.*:STAR_ALIGN' { cpus = 12; memory = 48.GB; time = 8.h }
}
